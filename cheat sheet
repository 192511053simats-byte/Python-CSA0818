1. Factorial of a Number

Formula:
fact(n) = n × fact(n-1)

Base:
fact(0) = 1

int fact(int n)
{
    if(n == 0)
        return 1;
    return n * fact(n-1);
}

2. Fibonacci Series

Formula:
fib(n) = fib(n-1) + fib(n-2)

Base:
fib(0) = 0
fib(1) = 1

int fib(int n)
{
    if(n == 0) return 0;
    if(n == 1) return 1;

    return fib(n-1) + fib(n-2);
}

3. Sum of Natural Numbers

Formula:
sum(n) = n + sum(n-1)

Base:
sum(0) = 0

int sum(int n)
{
    if(n == 0)
        return 0;
    return n + sum(n-1);
}

4. Sum of Digits

Formula:
sumDigits(n) = lastDigit + sumDigits(rest)

Logic:
lastDigit = n % 10
rest = n / 10

Base:
sumDigits(0) = 0

int sumDigits(int n)
{
    if(n == 0)
        return 0;

    return (n % 10) + sumDigits(n / 10);
}

5. Reverse a Number

Formula:
rev = rev * 10 + last digit

int rev = 0;

void reverse(int n)
{
    if(n == 0)
        return;

    rev = rev*10 + (n%10);
    reverse(n/10);
}

6. Power of a Number (a^b)

Formula:
power(a, b) = a × power(a, b-1)

Base:
power(a, 0) = 1

int power(int a, int b)
{
    if(b == 0)
        return 1;
    return a * power(a, b-1);
}

7. GCD (Greatest Common Divisor)

Euclidean Formula:
gcd(a, b) = gcd(b, a % b)

Base:
If b == 0 → return a

int gcd(int a, int b)
{
    if(b == 0)
        return a;
    return gcd(b, a % b);
}

8. LCM using Recursion

Formula:
LCM = (a * b) / GCD(a, b)

int gcd(int a, int b)
{
    if(b == 0)
        return a;
    return gcd(b, a % b);
}

int lcm(int a, int b)
{
    return (a * b) / gcd(a, b);
}

9. Check Palindrome (Number)
int rev = 0;

void reverse(int n)
{
    if(n == 0) return;
    rev = rev*10 + n%10;
    reverse(n/10);
}

int main()
{
    int n;
    scanf("%d",&n);

    int original = n;
    reverse(n);

    if(original == rev)
        printf("Palindrome");
    else
        printf("Not Palindrome");
}

10. Count Digits

Formula:
count(n) = 1 + count(n/10)

Base:
If n == 0 → return 0

int countDigits(int n)
{
    if(n == 0)
        return 0;

    return 1 + countDigits(n/10);
}

11. Multiply Two Numbers using Recursion
int multiply(int a, int b)
{
    if(b == 0)
        return 0;
    return a + multiply(a, b-1);
}

12. Check Prime using Recursion
int isPrime(int n, int i)
{
    if(n <= 2)
        return (n == 2);
    if(n % i == 0)
        return 0;
    if(i * i > n)
        return 1;

    return isPrime(n, i+1);
}


Call:

isPrime(n, 2);

